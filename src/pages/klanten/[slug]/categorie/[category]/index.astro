---
import ClientLayout from "../../../../../layouts/ClientLayout.astro";
import ArticleListRow from "../../../../../components/ArticleListRow.astro";
import { CATEGORIES } from "../../../../../content.config";
import { slugifyCategory } from "../../../../../lib/slug";
import { getAllClients, getRelatedWikiByCategory } from "../../../../../lib/client-nav";

export async function getStaticPaths() {
  const clients = await getAllClients();
  const paths = [];
  for (const client of clients) {
    const byCategory = await getRelatedWikiByCategory(client.id);
    for (const category of CATEGORIES) {
      const pages = byCategory.get(category) ?? [];
      if (pages.length === 0) continue;
      paths.push({
        params: { slug: client.id, category: slugifyCategory(category) },
        props: { client, category, pages },
      });
    }
  }
  return paths;
}

const { client, category, pages } = Astro.props;
const base = import.meta.env.BASE_URL.replace(new RegExp("/?$"), "/"); // garandeer trailing slash
---

<ClientLayout
  title={`${category} - ${client.data.title}`}
  description={`Wiki-pagina's in de categorie ${category} voor ${client.data.title}.`}
  activeId={client.id}
  pageHeadings={[]}
>
  <div class="wiki-crumb">
    <a href={`${base}klanten/`}>Klanten</a> <span>/</span>
    <a href={`${base}klanten/${client.id}/`}>{client.data.title}</a> <span>/</span>
    <span>{category}</span>
  </div>
  <h1 class="wiki-title">{category}</h1>
  <p class="lede">Wiki-pagina's in de categorie {category} voor {client.data.title}.</p>
  <div class="stack">
    {
      pages.map((entry) => (
        <ArticleListRow
          href={`${base}wiki/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
        />
      ))
    }
  </div>
</ClientLayout>
