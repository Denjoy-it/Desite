---
import { getCollection, render } from "astro:content";
import WikiLayout from "../../layouts/WikiLayout.astro";
import { slugifyCategory } from "../../lib/slug";

export async function getStaticPaths() {
  const pages = await getCollection("wiki");
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allClients = await getCollection("clients");
const linkedClients = allClients.filter((c) => entry.data.clients.includes(c.id));
---

<WikiLayout
  title={entry.data.title}
  description={entry.data.description}
  activeId={entry.id}
  pageHeadings={headings}
>
  <div class="wiki-crumb">
    <a href="/wiki/">Wiki</a> <span>/</span>
    <a href={`/wiki/categorie/${slugifyCategory(entry.data.category)}/`}>{entry.data.category}</a>
  </div>
  <h1 class="wiki-title">{entry.data.title}</h1>
  {entry.data.description && <p class="lede">{entry.data.description}</p>}
  {
    linkedClients.length > 0 && (
      <div class="client-tags">
        <span class="client-tags-label">Klant:</span>
        {linkedClients.map((c) => (
          <a class="badge b-info" href={`/klanten/${c.id}/`}>
            {c.data.title}
          </a>
        ))}
      </div>
    )
  }
  <article>
    <Content />
  </article>
</WikiLayout>
