---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { formatDate } from "../../lib/format";
import KlantGate from "../../components/KlantGate.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allClients = await getCollection("clients");
const linkedClients = allClients.filter((c) => post.data.clients.includes(c.id));
const isClientLinked = linkedClients.length > 0;
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  kicker="Desite · Blog"
  facts={[
    { label: "Categorie", value: post.data.category },
    { label: "Datum", value: formatDate(post.data.date), mono: true },
  ]}
  headings={headings}
>
  <KlantGate active={isClientLinked} extraHashes={linkedClients.map((c) => c.data.gatePassphraseHash)}>
    <Content />
  </KlantGate>
</ArticleLayout>
