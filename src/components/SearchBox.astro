---
// Pagefind's Component UI (web components), getheemd via de --pf-* custom
// properties in src/styles/global.css. Let op: de zoekindex wordt pas
// gebouwd bij `npm run build` (astro-pagefind-integratie) - in `npm run dev`
// zonder eerdere build levert zoeken geen resultaten op.
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<PagefindConfig />
<pagefind-modal-trigger
  class="search-trigger"
  placeholder="Zoeken in Desite..."
  shortcut="ctrl+k,meta+k"
  compact
></pagefind-modal-trigger>
<pagefind-modal></pagefind-modal>
