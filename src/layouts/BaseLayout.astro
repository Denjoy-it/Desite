---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ToTop from "../components/ToTop.astro";

interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title,
  description = "Desite - kennisbank voor Microsoft cloud-beheer.",
  noIndex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(new RegExp("/?$"), "/"); // garandeer trailing slash
---

<!doctype html>
<html lang="nl" data-pagefind-ignore={noIndex ? "all" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {noIndex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ToTop />
  </body>
</html>
