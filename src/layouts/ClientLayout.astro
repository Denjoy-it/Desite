---
import BaseLayout from "./BaseLayout.astro";
import ClientSidebar from "../components/ClientSidebar.astro";
import MermaidInit from "../components/MermaidInit.astro";
import KlantGate from "../components/KlantGate.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  activeId?: string;
  pageHeadings?: Heading[];
  /** SHA-256-hash van de passphrase van deze specifieke klant (naast de masterpassphrase). */
  gateHashes?: (string | undefined)[];
}

const { title, description, activeId, pageHeadings, gateHashes = [] } = Astro.props;
---

<BaseLayout title={`${title} - Desite`} description={description} noIndex={true}>
  <KlantGate extraHashes={gateHashes}>
    <div class="wiki-shell">
      <ClientSidebar activeId={activeId} pageHeadings={pageHeadings} />
      <div class="wiki-content reveal">
        <slot />
      </div>
    </div>
  </KlantGate>
</BaseLayout>

<MermaidInit />
